# Installs on g1t's runners (and anywhere else) retry a dropped connection
# to the registry more patiently than npm's default of two quick retries:
# an ECONNRESET partway through a 1,300-package install used to fail CI.
fetch-retries=5
fetch-retry-mintimeout=5000
fetch-retry-maxtimeout=60000
# Fewer connections at once than npm's 15: on g1t's cloud runners each one
# passes through the runner Worker, and bursts of parallel tarball
# downloads are when a body broke off midway.
maxsockets=8

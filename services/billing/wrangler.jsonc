{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "g1t-billing",
	"account_id": "1e6f2cffa3f445920836e8ebe446bb58",
	"compatibility_date": "2026-09-26",
	// Runs next to its database: a request makes several queries in turn,
	// and each would otherwise cross the distance to it.
	"placement": { "mode": "smart" },
	"main": "build/index.js",
	"build": { "command": "cargo install -q worker-build@0.8.7 && worker-build --release" },
	// Reached only through service bindings.
	"workers_dev": false,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "g1t-billing",
			"database_id": "695a6979-fd07-4850-bc97-904a6b4b7a04",
			"migrations_dir": "migrations"
		}
	],
	// Identity emails owners as their workspace nears its usage limit.
	// Repos says which repositories are public (the open-source pool pays
	// for work on those) and what private ones hold (the storage meter).
	"services": [
		{ "binding": "IDENTITY", "service": "g1t-identity" },
		{ "binding": "REPOS", "service": "g1t-repos" }
	],
	// Events from the bus: a workspace renamed moves its billing to the
	// new slug (src/rename.rs).
	"queues": {
		"consumers": [{ "queue": "g1t-events-billing", "max_batch_size": 20, "max_batch_timeout": 1 }]
	},
	"vars": {
		// What is added to a model run's cost, in percent: g1t's overhead for
		// running and building it. The price book's markups are the same.
		"MARGIN_PERCENT": "20",
		// While g1t is being built out, workspaces pay nothing: runs are
		// recorded with what they cost, and nothing is charged. Set to
		// "false" when pricing starts.
		// Off: workspaces are charged as their account's terms say. g1t's own
		// (syntaqx) is comped in sudo.g1t.sh, not by this switch.
		"FREE_WHILE_BUILDING": "false",
		// How far a workspace's unpaid usage may go before its work stops
		// (see src/limits.rs): $3 before any live payment, then twice what
		// it has paid, between $25 and $1,000. Comped and custom terms are set
		// per account in sudo.g1t.sh.
		"LIMIT_NEW_MICROS": "3000000",
		"LIMIT_PAID_MIN_MICROS": "25000000",
		"LIMIT_PAID_MAX_MICROS": "1000000000",
		// Trial credit, so people can try g1t without a key or a card: each
		// new workspace gets this much usage credit ($1), once, granted the
		// first time it uses something, out of a pool for everyone ($40)
		// that resets each calendar month (UTC). When a month's pool is
		// given out, new trials wait for the next month. Either at 0 turns
		// new trials off. See src/credits.rs.
		"TRIAL_WORKSPACE_MICROS": "1000000",
		"TRIAL_MONTHLY_POOL_MICROS": "40000000",
		// g1t's open-source pool: sandbox time and model cost for work on
		// public repositories, up to $10 a month in all and $1 a month for
		// any one repository. Past either, the workspace pays as usual.
		"OSS_POOL_MICROS": "10000000",
		"OSS_REPO_MICROS": "1000000",
		// The Team plan: $20 a month per workspace, never per person, with
		// $5 of usage credit a month (drawn first; it does not roll over),
		// 50 GB of private storage and a year of audit log.
		"TEAM_MONTHLY_CENTS": "2000",
		"TEAM_INCLUDED_MICROS": "5000000",
		"TEAM_PRIVATE_STORAGE_BYTES": "50000000000",
		"TEAM_AUDIT_RETENTION_DAYS": "365",
		// Without Team: 1 GB of private storage free (charged past it at
		// cost plus the margin), and 30 days of audit log.
		"FREE_PRIVATE_STORAGE_BYTES": "1000000000",
		"AUDIT_RETENTION_DAYS": "30",
		// No card is charged less than $5, so a payment's fee is never most
		// of it: smaller amounts carry over to the next invoice.
		"MIN_CHARGE_MICROS": "5000000",
		// The Deployments plan's monthly price, in cents. Turning the
		// feature on starts it; FREE_WHILE_BUILDING does not cover it. It
		// includes 200 build minutes a month (about $0.25 of it at cost).
		"DEPLOYMENTS_MONTHLY_CENTS": "500",
		"DEPLOYMENTS_BUILD_SECONDS": "12000",
		// Where the keeper reads what g1t pays (src/keeper.rs). Its token,
		// CLOUDFLARE_USAGE_TOKEN, is a secret: Billing, Account Analytics
		// and AI Gateway, read only.
		"CLOUDFLARE_ACCOUNT_ID": "1e6f2cffa3f445920836e8ebe446bb58",
		"AI_GATEWAY_ID": "g1t"
	},
	// Settling runs every 15 minutes; checking costs daily (keeper::DAILY).
	"triggers": { "crons": ["*/15 * * * *", "17 4 * * *"] },
	// Secret: STRIPE_SECRET_KEY. Without it nothing is charged and the
	// runner decides who may start agents some other way.
	"observability": { "enabled": true }
}

{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "g1t-billing",
	"account_id": "1e6f2cffa3f445920836e8ebe446bb58",
	"compatibility_date": "2026-09-26",
	// Runs next to its database: a request makes several queries in turn,
	// and each would otherwise cross the distance to it.
	"placement": { "mode": "off" },
	"main": "build/index.js",
	"build": { "command": "node ../../scripts/build-rust-worker.mjs" },
	// Reached only through service bindings.
	"workers_dev": false,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "g1t-billing",
			"database_id": "695a6979-fd07-4850-bc97-904a6b4b7a04",
			"migrations_dir": "migrations"
		}
	],
	// Identity emails owners as their workspace nears its usage limit.
	// Repos says which repositories are public (the open-source pool pays
	// for work on those) and what private ones hold (the storage meter).
	"services": [
		{ "binding": "IDENTITY", "service": "g1t-identity" },
		{ "binding": "REPOS", "service": "g1t-repos" }
	],
	// Margin alerts to staff (src/margin.rs), through Cloudflare Email
	// Sending like identity's and the status page's mail.
	"send_email": [{ "name": "EMAIL", "remote": true }],
	// Events from the bus: a workspace renamed moves its billing to the
	// new slug (src/rename.rs).
	"queues": {
		"consumers": [{ "queue": "g1t-events-billing", "max_batch_size": 20, "max_batch_timeout": 1 }]
	},
	"vars": {
		// What is added to a model run's cost, in percent: g1t's overhead for
		// running and building it. The price book's markups are the same.
		"MARGIN_PERCENT": "20",
		// While g1t is being built out, workspaces pay nothing: runs are
		// recorded with what they cost, and nothing is charged. Set to
		// "false" when pricing starts.
		// Off: workspaces are charged as their account's terms say. g1t's own
		// (flagon-io, Flagon, Inc.'s) is comped in sudo.g1t.sh, not by this switch.
		"FREE_WHILE_BUILDING": "false",
		// The g1t plan (src/features.rs): $20 a month per workspace, never
		// per person. It includes $10 of usage a month at cost plus 20%, used
		// first and not rolled over; the other $10 pays for running g1t, the
		// free forge for everyone, and the people building it. No quotas:
		// builds, requests, CPU, custom domains, storage and git operations
		// are all metered at cost plus 20% and drawn from the $10 first; only
		// the workspace's spend limit stops it. Projects are not metered.
		"PLAN_MONTHLY_CENTS": "2000",
		"PLAN_INCLUDED_MICROS": "10000000",
		// 1 GB of private storage free for every workspace: past it, the plan
		// pays at cost plus the margin, and a free workspace's pushes to
		// private repositories stop. The audit log is kept 90 days on every plan.
		"FREE_PRIVATE_STORAGE_BYTES": "1000000000",
		"AUDIT_RETENTION_DAYS": "90",
		// The trial (src/credits.rs, src/cards.rs): $5 of usage once per new
		// workspace, granted after a card check (one per card), out of a pool
		// for everyone ($100) that resets each calendar month (UTC). Either at
		// 0 turns new trials off. Never for deployments.
		"TRIAL_WORKSPACE_MICROS": "5000000",
		"TRIAL_MONTHLY_POOL_MICROS": "100000000",
		// g1t's open-source pool: checks, workflows and the merge queue on
		// public repositories, for any workspace with a card check, up to $25
		// a month in all and $2 a month for any one repository.
		"OSS_POOL_MICROS": "25000000",
		"OSS_REPO_MICROS": "2000000",
		// Ceilings on usage not yet paid for (src/limits.rs): $3 for a free
		// workspace (it has no on-demand compute), $100 for a paid one's first
		// month, then twice what it has paid as payments clear, between the
		// start and $1,000 (Established: its monthly spend, up to $10,000).
		"LIMIT_NEW_MICROS": "3000000",
		"LIMIT_PAID_START_MICROS": "100000000",
		"LIMIT_PAID_MIN_MICROS": "25000000",
		"LIMIT_PAID_MAX_MICROS": "1000000000",
		// Caps on agents (src/compute.rs): what the agents on one issue may
		// spend in all. One run's spend cap is DEFAULT_RUN_CAP_MICROS in
		// crates/contracts (guardrails.rs), shared with the guardrails' cost
		// per run; RUN_CAP_MICROS here would override it. Owners and staff
		// can change both.
		"ISSUE_CAP_MICROS": "10000000",
		// A spike: an hour's spend above 5 times the usual hour over the last
		// week, and at least $5, pauses new compute until an owner confirms.
		"SPIKE_FACTOR": "5",
		"SPIKE_FLOOR_MICROS": "5000000",
		// The most of an overage's real cost a one-click goodwill credit
		// covers (src/overages.rs); it always gives back the margin too.
		"OVERAGE_FORGIVE_COST_MICROS": "50000000",
		// Git operations through g1t (src/storage.rs): 50,000 a month free for
		// every workspace; past it the plan pays at cost plus 20% and is never
		// slowed, and a free workspace is slowed down by the repos service
		// (its GIT_OPERATIONS_FREE_CAP, the same number), never charged.
		"GIT_OPERATIONS_INCLUDED": "50000",
		// A month's close charges no less than $5, so a payment's fee is never
		// most of it: smaller amounts carry over. Charges at a limit always go
		// through.
		"MIN_CHARGE_MICROS": "5000000",
		// Where the keeper reads what g1t pays (src/keeper.rs). Its token,
		// CLOUDFLARE_USAGE_TOKEN, is a secret: Billing, Account Analytics
		// and AI Gateway, read only. The daily cost reconciliation
		// (src/costs.rs, src/margin.rs) reads the bill with
		// CLOUDFLARE_BILLING_TOKEN (Account: Billing Read, Account Analytics
		// Read) when it is set, else with the usage token. With neither it
		// reconciles only what g1t counted itself. See
		// docs/BILLING_OPERATIONS.md.
		"CLOUDFLARE_ACCOUNT_ID": "1e6f2cffa3f445920836e8ebe446bb58",
		"AI_GATEWAY_ID": "g1t",
		// Where margin alerts go: a product or all of g1t under the margin
		// floor, leaks, drift. Empty sends none (sudo still shows them).
		"COSTS_ALERT_EMAIL": "hey@flagon.io",
		// What g1t pays for itself, capped (src/budget.rs), at cost:
		// a comped account's (flagon-io's) work, $150 a month, unless its
		// terms in sudo set its own limit; alerts at 50, 75, 90 and 100% to
		// COSTS_ALERT_EMAIL, and at 100% new work on it is refused.
		"COMPED_MONTHLY_CEILING_MICROS": "150000000",
		// All of g1t's own spend in a day (comped, the trial and open-source
		// pools, free overruns, anything charged without real money): at
		// $75, new agent runs on hosted models that g1t pays for pause until
		// 00:00 UTC; staff are emailed and can lift it in sudo. Workspaces
		// paying with real money are never paused. 0 turns either cap off.
		"PLATFORM_DAILY_SPEND_CAP_MICROS": "75000000",
		// Cloudflare's fixed subscriptions a month, for sudo's figures only:
		// Workers Paid ($5) and Workers for Platforms ($25).
		"CLOUDFLARE_FIXED_MONTHLY_MICROS": "30000000"
	},
	// Settling runs every 15 minutes; checking costs daily (keeper::DAILY).
	"triggers": { "crons": ["*/15 * * * *", "17 4 * * *"] },
	// Secret: STRIPE_SECRET_KEY. Without it nothing is charged and the
	// runner decides who may start agents some other way.
	"observability": { "enabled": true }
}

{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "g1t-billing",
	"account_id": "1e6f2cffa3f445920836e8ebe446bb58",
	"compatibility_date": "2026-09-26",
	// Runs next to its database: a request makes several queries in turn,
	// and each would otherwise cross the distance to it.
	"placement": { "mode": "smart" },
	"main": "build/index.js",
	"build": { "command": "cargo install -q worker-build@0.8.7 && worker-build --release" },
	// Reached only through service bindings.
	"workers_dev": false,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "g1t-billing",
			"database_id": "695a6979-fd07-4850-bc97-904a6b4b7a04",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		// What is added to a run's cost, in percent. It pays the card
		// processor's fee and the sandbox the agent ran in.
		"MARGIN_PERCENT": "20",
		// What a run on a workspace's own model provider is charged, in
		// millionths of a dollar: the sandbox and the orchestration around
		// it, with the model paid for at the provider. $0.10.
		"ORCHESTRATION_FEE_MICROS": "100000",
		// While g1t is being built out, workspaces pay nothing: runs are
		// recorded with what they cost, and nothing is charged. Set to
		// "false" when pricing starts.
		"FREE_WHILE_BUILDING": "true",
		// How far a workspace's unpaid usage may go before its work stops
		// (see src/limits.rs): $3 before any live payment, then twice what
		// it has paid, between $25 and $1,000. LIMIT_EXEMPT is g1t's own.
		"LIMIT_NEW_MICROS": "3000000",
		"LIMIT_PAID_MIN_MICROS": "25000000",
		"LIMIT_PAID_MAX_MICROS": "1000000000",
		"LIMIT_EXEMPT": "syntaqx",
		// A free allowance on g1t's hosted models, so people can try g1t's
		// agents without a key of their own: each workspace may use this
		// much model cost ($1), out of one pool for everyone ($40), until
		// the end of finalist judging (2026-10-22, 11:59 PM Pacific). Any
		// of them empty turns it off.
		"TRIAL_WORKSPACE_MICROS": "1000000",
		"TRIAL_TOTAL_MICROS": "40000000",
		"TRIAL_UNTIL": "2026-10-23T06:59:59Z",
		// The Deployments plan's monthly price, in cents. Turning the
		// feature on starts it; FREE_WHILE_BUILDING does not cover it.
		"DEPLOYMENTS_MONTHLY_CENTS": "500"
	},
	// Secret: STRIPE_SECRET_KEY. Without it nothing is charged and the
	// runner decides who may start agents some other way.
	"observability": { "enabled": true }
}

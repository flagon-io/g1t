{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "g1t-models",
	"account_id": "1e6f2cffa3f445920836e8ebe446bb58",
	"compatibility_date": "2026-09-26",
	"main": "./src/index.ts",
	"workers_dev": false,
	// Sandboxes reach models only through here, with a token for their run;
	// a workspace's own code reaches the AI Gateway here with one of its
	// access tokens, at /anthropic or /openai/v1.
	"routes": [{ "pattern": "models.g1t.sh", "custom_domain": true }],
	"services": [
		{ "binding": "INTEGRATIONS", "service": "g1t-integrations" },
		// Where each run's tokens are counted, for usage views.
		{ "binding": "BILLING", "service": "g1t-billing" },
		// Who an AI Gateway request's access token belongs to, and its scopes.
		{ "binding": "IDENTITY", "service": "g1t-identity" }
	],
	// Each run's model spend, one object per model session, so its cost cap
	// holds across every isolate its requests reach (src/run-spend.ts).
	"durable_objects": {
		"bindings": [{ "name": "RUN_SPEND", "class_name": "RunSpend" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["RunSpend"] }],
	"vars": {
		// g1t's own route, for runs g1t pays for: a Cloudflare AI Gateway,
		// which holds g1t's key.
		"AI_GATEWAY_ID": "g1t",
		"CLOUDFLARE_ACCOUNT_ID": "1e6f2cffa3f445920836e8ebe446bb58"
	},
	// Once a day, after billing's daily run: every provider's model list,
	// recorded with billing's catalogue (src/discover.ts). sudo's "Check
	// for new models" does the same through the `Discovery` entrypoint.
	"triggers": { "crons": ["29 5 * * *"] },
	// Secrets: AI_GATEWAY_TOKEN; ANTHROPIC_API_KEY only if the gateway does
	// not hold g1t's key; WORKERS_AI_TOKEN, a Cloudflare API token with
	// Workers AI Read on this account, for the AI Gateway's open models
	// (without it AI_GATEWAY_TOKEN is tried, and needs that permission too).
	"observability": { "enabled": true }
}

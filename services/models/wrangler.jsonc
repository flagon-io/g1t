{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "g1t-models",
	"account_id": "1e6f2cffa3f445920836e8ebe446bb58",
	"compatibility_date": "2026-09-26",
	"main": "./src/index.ts",
	"workers_dev": false,
	// Sandboxes reach models only through here, with a token for their run;
	// a workspace's own code reaches the AI Gateway here with one of its
	// access tokens.
	"routes": [{ "pattern": "models.g1t.sh", "custom_domain": true }],
	"services": [
		{ "binding": "INTEGRATIONS", "service": "g1t-integrations" },
		// Where each run's tokens are counted, for usage views.
		{ "binding": "BILLING", "service": "g1t-billing" },
		// Who an AI Gateway request's access token belongs to, and its scopes.
		{ "binding": "IDENTITY", "service": "g1t-identity" }
	],
	"vars": {
		// g1t's own route, for runs g1t pays for: a Cloudflare AI Gateway,
		// which holds g1t's key.
		"AI_GATEWAY_ID": "g1t",
		"CLOUDFLARE_ACCOUNT_ID": "1e6f2cffa3f445920836e8ebe446bb58"
	},
	// Secrets: AI_GATEWAY_TOKEN; ANTHROPIC_API_KEY only if the gateway does
	// not hold g1t's key.
	"observability": { "enabled": true }
}

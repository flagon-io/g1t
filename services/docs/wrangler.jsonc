{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "g1t-docs-service",
	"account_id": "1e6f2cffa3f445920836e8ebe446bb58",
	"compatibility_date": "2026-09-26",
	"main": "./src/index.ts",
	// Reached only through service bindings. The live socket's and uploads'
	// viewer comes in a header the site sets after checking the session,
	// which is only safe to trust because nothing else can reach this Worker.
	"workers_dev": false,
	"placement": { "mode": "off" },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "g1t-docs",
			// Create it once, then put its id here:
			//   npx wrangler d1 create g1t-docs
			//   npx wrangler d1 migrations apply g1t-docs --remote
			"database_id": "8f2193ed-fd2b-4322-b6cb-c79090e7603d",
			"migrations_dir": "migrations"
		}
	],
	// Files people put in pages (images, attachments), served from the
	// usercontent origin at /docs-files/<key> (apps/web/workers/usercontent.ts).
	// Create it once: npx wrangler r2 bucket create g1t-docs-files
	// Self-hosted, any S3-compatible store instead: DOCS_FILES=s3 and the
	// DOCS_S3_* settings (src/files.ts, docs/SELF_HOSTING.md).
	"r2_buckets": [{ "binding": "FILES", "bucket_name": "g1t-docs-files" }],
	// The semantic index agents recall from (src/indexer.ts, src/vectors.ts):
	// Workers AI embeds passages (@cf/baai/bge-base-en-v1.5, 768 dimensions)
	// into Vectorize, with metadata indexes on workspace_id and space_id so a
	// query only reads spaces its reader may. Create it once:
	//   npx wrangler vectorize create g1t-docs --dimensions=768 --metric=cosine
	//   npx wrangler vectorize create-metadata-index g1t-docs --property-name=workspace_id --type=string
	//   npx wrangler vectorize create-metadata-index g1t-docs --property-name=space_id --type=string
	// Without them Docs still keeps passages in D1 and recall matches words.
	"ai": { "binding": "AI" },
	"vectorize": [{ "binding": "VECTORS", "index_name": "g1t-docs" }],
	"services": [
		// Workspaces by slug, people's names and avatars, and teams.
		{ "binding": "IDENTITY", "service": "g1t-identity" },
		// The workspace's agents: who they are, for agents' calls and mentions.
		{ "binding": "AGENTS", "service": "g1t-agents" },
		// Mentions and suggestions reach people's inboxes (services/notify).
		{ "binding": "NOTIFY", "service": "g1t-notify" },
		// Who may read a repository, what a change touched, and a project's
		// docs folder (src/staleness.ts, src/repo-spaces.ts).
		{ "binding": "REPOS", "service": "g1t-repos" },
		// What a merged pull request changed.
		{ "binding": "WORK", "service": "g1t-work" },
		// doc.page.* events on the bus (src/events.ts).
		{ "binding": "EVENTS", "service": "g1t-events" }
	],
	// Merges and pushes to default branches: pages whose cited code
	// changed, and projects' docs read again (src/staleness.ts). The events
	// service sends it what g1t_contracts::subscribers routes to
	// SUBSCRIBER_DOCS. Create it once: npx wrangler queues create g1t-events-docs
	"queues": {
		// Its own backfill jobs ride the same queue (`docs.index`,
		// src/indexer.ts): a workspace's pages and projects' docs indexed in
		// batches, and waiting out the hourly embedding cap.
		"producers": [{ "binding": "JOBS", "queue": "g1t-events-docs" }],
		"consumers": [{ "queue": "g1t-events-docs", "max_batch_size": 20, "max_batch_timeout": 2, "max_retries": 3, "dead_letter_queue": "g1t-events-dlq" }]
	},
	// One room per page: it holds the page's Yjs document and open sockets,
	// hibernating while nobody types (src/room.ts).
	"durable_objects": {
		"bindings": [{ "name": "PAGES", "class_name": "PageRoom" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["PageRoom"] }],
	"observability": { "enabled": true, "head_sampling_rate": 0.1 }
}

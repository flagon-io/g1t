{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "g1t-runner",
  "account_id": "1e6f2cffa3f445920836e8ebe446bb58",
  "compatibility_date": "2026-09-26",
  "main": "./src/index.ts",
  "workers_dev": false,
  // One image (the base plus the runner binary), on three named instance
  // types, as GitHub sizes its hosted runners (GITHUB_HOSTED_LABELS in
  // crates/contracts): standard-3 (2 vCPU, 8 GiB, 16 GB of disk) for the
  // standard machine, which ubuntu-latest and the other Ubuntu labels get
  // in a private repository; standard-4 (4 vCPU, 12 GiB, 20 GB, the largest
  // Containers instance) for the 4-core one, which they get in a public
  // repository; and standard-2 (1 vCPU, 6 GiB, 12 GB) for ubuntu-slim. The
  // git edge runs the same image on standard-2. At these max_instances, 90
  // sandboxes and 10 edges at once hold 240 vCPU, 880 GiB and 1,640 GB,
  // well inside the account's limits for live instances (1,500 vCPU, 6 TiB
  // of memory, 30 TB of disk). crates/contracts (INSTANCE_TYPES) and
  // services/billing (keeper.rs) say the same sizes.
  // scripts/deploy.mjs deploys with each image set to the reference it
  // built and pushed ("The runner's images" in
  // docs.g1t.sh/guides/deploy-to-cloudflare/), so a deploy builds
  // nothing; "./Dockerfile" here is for building by hand.
  "containers": [
    {
      "class_name": "AttemptSandbox",
      "image": "./Dockerfile",
      // Workflow jobs with `runs-on: ubuntu-latest` (and the other Ubuntu
      // labels) in a private repository, any label g1t does not know,
      // checks, the merge queue and all other work: 2 vCPU, 8 GiB, 16 GB.
      // Most jobs run here, so it has the most room.
      "instance_type": "standard-3",
      "max_instances": 50,
      // A deploy that changes the image or these settings replaces every
      // idle sandbox at once (scripts/deploy.mjs passes
      // --containers-rollout=immediate). Ones that are busy are given
      // this long, in seconds, to finish first, so shipping g1t does not
      // kill work in the middle.
      "rollout_active_grace_period": 7200
    },
    {
      // Workflow jobs with `runs-on: ubuntu-slim`: 1 vCPU, 6 GiB, 12 GB.
      "class_name": "SandboxSlim",
      "image": "./Dockerfile",
      "instance_type": "standard-2",
      "max_instances": 10,
      "rollout_active_grace_period": 7200
    },
    {
      // Workflow jobs with `runs-on: ubuntu-latest` (and the other Ubuntu
      // labels) in a public repository: 4 vCPU, 12 GiB, 20 GB. GitHub's
      // has 16 GB of memory; 12 GiB is the most a Containers instance has.
      "class_name": "SandboxLarge",
      "image": "./Dockerfile",
      "instance_type": "standard-4",
      "max_instances": 30,
      "rollout_active_grace_period": 7200
    },
    {
      // The git edge (src/gitedge.ts): not a machine jobs can ask for, so
      // it is in no machine catalogue. Every repository has one, started
      // when it is cloned twice within the hour (and asleep after 10
      // minutes without a request): the same image started as the edge's
      // server (MODE=gitedge), on standard-2 (1 vCPU, 6 GiB, 12 GB; a
      // repository is at most 950 MB) because repacking a mirror needs
      // memory and CPU. max_instances bounds how many repositories have a
      // live edge at once, and so what they can cost: 10 awake all month is
      // about $820 at list prices, the most the edge can cost, and a
      // repository cloned only now and then costs nothing. A clone of any
      // other repository is answered from Artifacts at once, as without the
      // edge, and its edge tries to start again two minutes later
      // (START_REST_MS).
      "class_name": "GitEdge",
      "image": "./Dockerfile",
      "instance_type": "standard-2",
      "max_instances": 10,
      // A clone under way when a deploy replaces its edge is given this
      // long, in seconds, to finish; the next one finds the edge cold.
      "rollout_active_grace_period": 300
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SANDBOX", "class_name": "AttemptSandbox" },
      { "name": "SANDBOX_SLIM", "class_name": "SandboxSlim" },
      { "name": "SANDBOX_LARGE", "class_name": "SandboxLarge" },
      { "name": "GIT_EDGE", "class_name": "GitEdge" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AttemptSandbox"] },
    { "tag": "v2", "new_sqlite_classes": ["Sandbox2Core", "Sandbox4Core"] },
    { "tag": "v3", "new_sqlite_classes": ["AgentComputer"] },
    // Workspace agents' computers are gone, and with them their objects.
    { "tag": "v4", "deleted_classes": ["AgentComputer"] },
    // Each repository's git edge.
    { "tag": "v5", "new_sqlite_classes": ["GitEdge"] },
    // g1t's labels became GitHub's: g1t-2core and g1t-4core are gone, and
    // with them their objects (each one job's sandbox, nothing kept past
    // it); ubuntu-slim has a class of its own.
    { "tag": "v6", "deleted_classes": ["Sandbox2Core", "Sandbox4Core"], "new_sqlite_classes": ["SandboxSlim"] },
    // A public repository's Ubuntu labels run on 4 vCPU again, as GitHub's
    // do, in a class of its own: Sandbox4Core's name went with v6.
    { "tag": "v7", "new_sqlite_classes": ["SandboxLarge"] }
  ],
  // The repos service's packs bucket: each repository's git edge keeps its
  // mirror there (packs/edge/<repo_id>/mirror.tar, src/gitedge.ts), so a
  // cold edge restores it rather than cloning the repository again. The
  // bucket's 7-day rule on packs/ deletes one nobody has cloned since.
  "r2_buckets": [{ "binding": "GIT_PACKS", "bucket_name": "g1t-git-packs" }],
  "services": [
    { "binding": "IDENTITY", "service": "g1t-identity" },
    { "binding": "REPOS", "service": "g1t-repos" },
    { "binding": "WORK", "service": "g1t-work" },
    { "binding": "BILLING", "service": "g1t-billing" },
    { "binding": "ACTIONS", "service": "g1t-actions" },
    { "binding": "DEPLOYMENTS", "service": "g1t-deployments" },
    // The event bus: abuse.flagged, when a sandbox looks like it is mining.
    { "binding": "EVENTS", "service": "g1t-events" }
  ],
  // A sweep for lifecycle steps whose trigger was missed or whose sandbox
  // died before reporting, which also starts queued nightly backups.
  "triggers": { "crons": ["*/5 * * * *"] },
  // Events it reacts to: a pull request that may now merge by its
  // repository's settings, a merge check or the merge queue to start.
  "queues": {
    "consumers": [{ "queue": "g1t-events-runner", "max_batch_size": 20, "max_batch_timeout": 1, "max_retries": 3, "dead_letter_queue": "g1t-events-dlq" }]
  },
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "1e6f2cffa3f445920836e8ebe446bb58",
    // Sandboxes reach the internet directly. A workflow job that may be
    // given brokered secrets passes its HTTP(S) through this Worker, which
    // fills them in. "off" passes nothing through it: stand-ins then go
    // out unfilled.
    "EGRESS": "on",
    // Sandboxes stop themselves when they look like they are mining
    // (crates/runner abuse.rs). "off" turns the CPU watch off; miners
    // named in commands are refused either way.
    "ABUSE_WATCH": "on",
    // Each workflow job gets a Docker Engine of its own, inside its
    // sandbox, started the first time a step uses Docker or the job has
    // `services:` or `container:` (crates/runner docker/). "off" gives
    // jobs none.
    "DOCKER": "on",
    // Nightly backups (src/backup.ts): each sweep starts this many of the
    // backups the repos service queued, with at most BACKUPS_RUNNING at
    // once. "0" starts none.
    "BACKUPS_PER_SWEEP": "4",
    "BACKUPS_RUNNING": "6"
  },
  // Every log kept: few requests, and a failed run must be traceable.
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}

{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "g1t-repos",
	"account_id": "1e6f2cffa3f445920836e8ebe446bb58",
	"compatibility_date": "2026-09-26",
	// Runs next to its database: a request makes several queries in turn,
	// and each would otherwise cross the distance to it.
	"placement": { "mode": "smart" },
	"main": "build/index.js",
	"build": { "command": "cargo install -q worker-build@0.8.7 && worker-build --release" },
	"workers_dev": false,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "g1t-repos",
			"database_id": "f9544c51-c3bf-4621-a96f-8a6d5cf24a97",
			"migrations_dir": "migrations"
		}
	],
	"artifacts": [{ "binding": "ARTIFACTS", "namespace": "g1t" }],
	// Shared between isolates (src/shared.rs): the git store's credentials
	// (src/store.rs) and the ref listings git asks for first
	// (src/refs_cache.rs), every value sealed with the REPOS_KEY secret (64
	// hex characters). Without the binding or the secret each isolate keeps
	// only its own. Made by `npx wrangler kv namespace create g1t-repos-git-cache`:
	"kv_namespaces": [{ "binding": "GIT_CACHE", "id": "be765052d0124c2a935b3db4dff99f1f" }],
	"services": [
		{ "binding": "IDENTITY", "service": "g1t-identity" },
		{ "binding": "EVENTS", "service": "g1t-events" },
		// Push protection asks which secrets were allowed, and records the rest.
		{ "binding": "SECURITY", "service": "g1t-security" },
		// Whether a workspace far past its free git operations is on the
		// plan (src/git_ops.rs); asked only then.
		{ "binding": "BILLING", "service": "g1t-billing" }
	],
	// A free workspace past this many git operations in a month is slowed
	// to this many an hour, never charged (src/git_ops.rs). It is billing's
	// GIT_OPERATIONS_INCLUDED, the amount free for every workspace: past it,
	// a workspace on the plan pays at cost plus 20% and is never slowed.
	// FREE_PRIVATE_STORAGE_BYTES: a free workspace's private repositories may
	// hold this much (1 GB); past it, pushes to them stop. Billing reads the
	// same amount.
	"vars": {
		"GIT_OPERATIONS_FREE_CAP": "50000",
		"GIT_OPERATIONS_FREE_HOURLY": "60",
		"FREE_PRIVATE_STORAGE_BYTES": "1000000000"
	},
	// Every hour, deleted repositories whose 30 days to be restored have
	// passed are purged, their git data with them (src/lifecycle.rs).
	"triggers": { "crons": ["23 * * * *"] },
	// A workspace renamed moves its repositories to the new slug; one
	// deleted purges the repositories it left in Recently deleted.
	"queues": {
		"consumers": [{ "queue": "g1t-events-repos", "max_batch_size": 20, "max_batch_timeout": 1 }]
	},
	"observability": { "enabled": true }
}

{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "g1t-api",
	"account_id": "1e6f2cffa3f445920836e8ebe446bb58",
	"compatibility_date": "2026-09-26",
	"main": "build/index.js",
	"build": { "command": "cargo install -q worker-build@0.8.7 && worker-build --release" },
	"workers_dev": false,
	// One Worker, two hostnames: REST on api, MCP on mcp. Both are thin
	// adapters over the same operations.
	"routes": [
		{ "pattern": "api.g1t.sh", "custom_domain": true },
		{ "pattern": "mcp.g1t.sh", "custom_domain": true }
	],
	"services": [
		{ "binding": "IDENTITY", "service": "g1t-identity" },
		{ "binding": "REPOS", "service": "g1t-repos" },
		{ "binding": "WORK", "service": "g1t-work" },
		{ "binding": "EVENTS", "service": "g1t-events" },
		{ "binding": "RUNNER", "service": "g1t-runner" },
		{ "binding": "BILLING", "service": "g1t-billing" },
		{ "binding": "INTEGRATIONS", "service": "g1t-integrations" },
		{ "binding": "WEBHOOKS", "service": "g1t-webhooks" },
		{ "binding": "AUTOMATIONS", "service": "g1t-automations" }
	],
	"observability": { "enabled": true }
}

---
// The API explorer, for trying calls from the browser: Scalar's explorer over g1t's OpenAPI
// document. It is a standalone page because the explorer brings its own
// layout. The reference itself is the Starlight pages under /reference/api/.
import '@g1t/theme/fonts.css';
import '@g1t/theme/tokens.css';
import sans from '@g1t/theme/fonts/hanken-grotesk-latin.woff2?url';

// The wordmark: G1T in pixel capitals, the 1 in lavender, as in
// src/components/SiteTitle.astro.
const G = ['.###.', '#...#', '#....', '#.###', '#...#', '#...#', '.###.'];
const ONE = ['..#..', '.##..', '#.#..', '..#..', '..#..', '..#..', '#####'];
const T = ['#####', '..#..', '..#..', '..#..', '..#..', '..#..', '..#..'];
const pixels = (rows: string[], dx: number, one: boolean) =>
	rows.flatMap((row, y) => [...row].flatMap((c, x) => (c === '#' ? [{ x: dx + x, y, one }] : [])));
const word = [...pixels(G, 0, false), ...pixels(ONE, 6, true), ...pixels(T, 10, false)];

const configuration = {
	theme: 'none',
	darkMode: true,
	hideDarkModeToggle: true,
	hideClientButton: true,
	hideModels: true,
	defaultHttpClient: { targetKey: 'shell', clientKey: 'curl' },
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>API explorer · g1t docs</title>
		<meta
			name="description"
			content="Every g1t API endpoint, with an explorer to call them from the page."
		/>
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="canonical" href="https://docs.g1t.sh/api/reference/" />
		<link rel="preload" href={sans} as="font" type="font/woff2" crossorigin />
	</head>
	<body>
		<header class="bar">
			<a class="brand" href="/" aria-label="g1t docs home">
				<svg viewBox="1 1 148 68" role="img" aria-label="g1t">
					{word.map((p) => (
						<rect
							x={p.x * 10 + 1}
							y={p.y * 10 + 1}
							width="8"
							height="8"
							fill={p.one ? 'var(--g1t-merged)' : 'currentColor'}
						/>
					))}
				</svg>
				<span class="pill">Docs</span>
			</a>
			<nav>
				<a href="/">Guides</a>
				<a href="/reference/api/">API reference</a>
				<a href="/reference/mcp/">MCP tools</a>
				<a href="https://api.g1t.sh/openapi.json">OpenAPI</a>
				<a href="https://g1t.sh/register" class="cta">Sign up</a>
			</nav>
		</header>
		<script
			is:inline
			id="api-reference"
			data-url="https://api.g1t.sh/openapi.json"
			data-configuration={JSON.stringify(configuration)}></script>
		<script is:inline src="https://cdn.jsdelivr.net/npm/@scalar/api-reference"></script>
	</body>
</html>

<style is:global>
	body {
		margin: 0;
		background: var(--g1t-bg);
	}

	/* Scalar's names for the shared g1t tokens. */
	:root {
		/* The g1t header above: Scalar's sticky sidebar starts below it. */
		--scalar-custom-header-height: 56px;
		--scalar-font: var(--g1t-font-sans);
		--scalar-font-code: var(--g1t-font-mono);
	}
	.dark-mode {
		--scalar-background-1: var(--g1t-bg);
		--scalar-background-2: var(--g1t-surface);
		--scalar-background-3: var(--g1t-raised);
		--scalar-border-color: var(--g1t-line);
		--scalar-color-1: var(--g1t-fg);
		--scalar-color-2: var(--g1t-muted);
		--scalar-color-3: var(--g1t-faint);
		--scalar-color-accent: #cfc6ff;
		--scalar-background-accent: color-mix(in srgb, var(--g1t-merged) 12%, transparent);
		--scalar-button-1: var(--g1t-fg);
		--scalar-button-1-color: var(--g1t-bg);
		--scalar-button-1-hover: #ffffff;
		--scalar-color-green: var(--g1t-accent);
		--scalar-color-blue: var(--g1t-info);
		--scalar-color-red: var(--g1t-danger);
		--scalar-color-orange: var(--g1t-warn);
		--scalar-sidebar-background-1: var(--g1t-bg);
		--scalar-sidebar-color-1: var(--g1t-fg);
		--scalar-sidebar-color-2: var(--g1t-muted);
		--scalar-sidebar-border-color: var(--g1t-line);
		--scalar-sidebar-item-hover-background: var(--g1t-surface);
		--scalar-sidebar-item-active-background: var(--g1t-raised);
		--scalar-sidebar-color-active: var(--g1t-fg);
	}

	.bar {
		position: sticky;
		top: 0;
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 56px;
		padding: 0 20px;
		background: color-mix(in srgb, var(--g1t-bg) 88%, transparent);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--g1t-line);
		font: 14px var(--g1t-font-sans);
	}
	.bar a {
		color: var(--g1t-muted);
		text-decoration: none;
	}
	.bar .brand {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		color: var(--g1t-fg);
	}
	.bar .brand svg {
		width: auto;
		height: 20px;
	}
	.bar .pill {
		border-radius: 999px;
		padding: 1px 8px;
		font-size: 11.5px;
		color: var(--g1t-muted);
		box-shadow: inset 0 0 0 1px var(--g1t-line-strong);
	}
	.bar nav {
		display: flex;
		align-items: center;
		gap: 4px;
	}
	.bar nav a {
		border-radius: 6px;
		padding: 5px 10px;
		font-size: 13.5px;
	}
	.bar nav a:hover {
		background: var(--g1t-raised);
		color: var(--g1t-fg);
	}
	.bar nav a.cta {
		margin-left: 4px;
		background: var(--g1t-fg);
		color: var(--g1t-bg);
		font-weight: 500;
	}
	@media (max-width: 760px) {
		.bar nav a:not(.cta) {
			display: none;
		}
	}
</style>

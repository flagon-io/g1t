---
// The cube, the name and "Docs": the same mark as g1t.sh, so the two read
// as one product.
---

<a href="/" class="g1t-title" aria-label="g1t docs home">
	<svg viewBox="0 0 32 32" aria-hidden="true">
		<path d="M16 2.5 28 9.4 16 16.3 4 9.4Z" fill="currentColor"></path>
		<path d="M4 10.9 15.3 17.4V30.2L4 23.7Z" fill="currentColor" fill-opacity="0.55"></path>
		<path d="M28 10.9 16.7 17.4V30.2L28 23.7Z" fill="currentColor" fill-opacity="0.25"></path>
	</svg>
	<span class="g1t-title-name">g1t</span>
	<span class="g1t-title-docs">Docs</span>
</a>

<style>
	.g1t-title {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		color: var(--g1t-fg);
		text-decoration: none;
	}
	svg {
		width: 1.35rem;
		height: 1.35rem;
	}
	.g1t-title-name {
		font-size: 1.05rem;
		font-weight: 700;
		letter-spacing: -0.035em;
	}
	.g1t-title-docs {
		border-radius: 999px;
		padding: 0.1rem 0.5rem;
		font-size: 0.72rem;
		font-weight: 500;
		color: var(--g1t-muted);
		box-shadow: inset 0 0 0 1px var(--g1t-line-strong);
	}
</style>

---
// The fleet, the name and "Docs": the same mark as g1t.sh, so the two read
// as one product.
---

<a href="/" class="g1t-title" aria-label="g1t docs home">
	<svg viewBox="0 0 32 32" aria-hidden="true">
		<g transform="translate(0.7 0.5)">
			<rect x="6.2" y="9.5" width="4.4" height="17" rx="2.2" fill="var(--g1t-merged)" fill-opacity="0.35"></rect>
			<rect x="12.4" y="7" width="4.8" height="19.5" rx="2.4" fill="var(--g1t-merged)" fill-opacity="0.65"></rect>
			<rect x="19" y="4.5" width="5.4" height="22" rx="2.7" fill="currentColor"></rect>
			<path d="M21.7 7.2 17.6 10.9" fill="none" stroke="currentColor" stroke-width="4.6" stroke-linecap="round"></path>
		</g>
	</svg>
	<span class="g1t-title-name">g1t</span>
	<span class="g1t-title-docs">Docs</span>
</a>

<style>
	.g1t-title {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		color: var(--g1t-fg);
		text-decoration: none;
	}
	svg {
		width: 1.35rem;
		height: 1.35rem;
	}
	.g1t-title-name {
		font-size: 1.05rem;
		font-weight: 700;
		letter-spacing: -0.035em;
	}
	.g1t-title-docs {
		border-radius: 999px;
		padding: 0.1rem 0.5rem;
		font-size: 0.72rem;
		font-weight: 500;
		color: var(--g1t-muted);
		box-shadow: inset 0 0 0 1px var(--g1t-line-strong);
	}
</style>

---
// The docs header: the wordmark, search in the middle and links on the
// right, with the tabs that divide the docs beneath it.
//
// Its own layout, not Starlight's: Starlight lines the search up with the
// page's text column, which moves when a page has an "On this page" list
// and when it does not. Here the row is three columns, the outer two always
// the same width, so the search sits at the header's centre on every page.
import Search from '@astrojs/starlight/components/Search.astro';

import { NAV } from '../route-data';
import SiteTitle from './SiteTitle.astro';
import SocialIcons from './SocialIcons.astro';
// Auto, Light or Dark, kept in this browser; Auto follows the system.
// On tablets and phones it is at the foot of the menu instead.
import ThemeToggle from './ThemeToggle.astro';

const tabs = NAV.get(Astro.locals.starlightRoute)?.tabs ?? [];
---

<div class="g1t-header">
	<div class="g1t-header-top">
		<div class="g1t-header-title"><SiteTitle /></div>
		<div class="g1t-header-search print:hidden"><Search /></div>
		<div class="g1t-header-links print:hidden">
			<SocialIcons />
			<div class="g1t-header-theme"><ThemeToggle /></div>
		</div>
	</div>
	<nav class="g1t-tabs" aria-label="Sections">
		{
			tabs.map((tab) => (
				<a href={tab.href} aria-current={tab.current ? 'page' : undefined}>
					{tab.label}
				</a>
			))
		}
	</nav>
</div>

<script>
	// On a phone the tabs scroll sideways: start with the current one in view.
	const current = document.querySelector<HTMLElement>('.g1t-tabs [aria-current]');
	const tabs = current?.parentElement;
	if (current && tabs && current.offsetLeft + current.offsetWidth > tabs.clientWidth) {
		tabs.scrollLeft = current.offsetLeft - (tabs.clientWidth - current.offsetWidth) / 2;
	}
</script>

<style>
	.g1t-header {
		display: flex;
		flex-direction: column;
		height: 100%;
	}
	/* The same bar as the app's: 3.5rem, and a line under it. */
	.g1t-header-top {
		/* Each side column is at least as wide as the widest thing that goes
		   in either, so the two stay equal and the search stays centred. */
		--g1t-header-side: 13.5rem;
		box-sizing: border-box;
		display: grid;
		grid-template-columns:
			minmax(var(--g1t-header-side), 1fr)
			minmax(0, 26rem)
			minmax(var(--g1t-header-side), 1fr);
		align-items: center;
		gap: 1rem;
		height: 3.5rem;
		flex-shrink: 0;
		padding: 0 var(--sl-nav-pad-x);
		border-bottom: 1px solid var(--g1t-line);
	}
	.g1t-header-title {
		display: flex;
		min-width: 0;
		/* Room for the link's focus ring. */
		padding: 0.25rem;
		margin: -0.25rem;
	}
	.g1t-header-search {
		display: flex;
		justify-content: center;
		min-width: 0;
	}
	.g1t-header-links {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.5rem;
		min-width: 0;
	}
	.g1t-header-theme {
		display: flex;
		align-items: center;
	}
	/* Desktop: the links and the theme button together are wider. */
	@media (min-width: 50rem) {
		.g1t-header-top {
			--g1t-header-side: 17.5rem;
		}
	}
	@media (min-width: 64rem) {
		.g1t-header-top {
			--g1t-header-side: 21rem;
		}
	}
	/* Tablets and phones: the theme select is at the foot of the menu. */
	@media (max-width: 49.99rem) {
		.g1t-header-theme {
			display: none;
		}
	}
	/* Tablets: the sidebar is a menu, and its button (fixed in place by
	   Starlight) takes the row's end. The right column makes room for it
	   inside itself, so the two columns stay equal and the search centred. */
	@media (max-width: 49.99rem) {
		.g1t-header-top {
			--g1t-header-side: 13rem;
		}
		:global([data-has-sidebar]) .g1t-header-links {
			padding-inline-end: calc(var(--sl-menu-button-size) + 0.5rem);
		}
	}
	/* Phones: the wordmark on the left; search, the links and the menu
	   button together on the right. */
	@media (max-width: 44.99rem) {
		.g1t-header-top {
			grid-template-columns: minmax(0, 1fr) auto auto;
			gap: 0.25rem;
		}
	}
	.g1t-tabs {
		/* The tabs' own offsets are measured from here. */
		position: relative;
		display: flex;
		gap: 1.5rem;
		height: 2.75rem;
		padding: 0 var(--sl-nav-pad-x);
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scrollbar-width: none;
	}
	.g1t-tabs::-webkit-scrollbar {
		display: none;
	}
	.g1t-tabs a {
		display: flex;
		flex-shrink: 0;
		align-items: center;
		border-bottom: 2px solid transparent;
		font-size: 0.875rem;
		font-weight: 500;
		white-space: nowrap;
		color: var(--g1t-muted);
		text-decoration: none;
		transition: color 0.15s;
	}
	.g1t-tabs a:hover {
		color: var(--g1t-fg);
	}
	.g1t-tabs a[aria-current='page'] {
		border-color: var(--g1t-accent);
		font-weight: 600;
		color: var(--g1t-fg);
	}
</style>

---
// The header's right side: where people go from the docs, then the source.
---

<nav class="g1t-nav" aria-label="g1t">
	<a href="/api/reference/">API reference</a>
	<a href="https://g1t.sh/">g1t.sh</a>
	<a href="https://g1t.sh/register" class="g1t-nav-cta">Sign up</a>
	<a href="https://github.com/syntaqx/g1t" aria-label="Source on GitHub" class="g1t-nav-icon">
		<svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
			<path
				d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
			></path>
		</svg>
	</a>
</nav>

<style>
	.g1t-nav {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}
	a {
		border-radius: 0.4rem;
		padding: 0.3rem 0.6rem;
		font-size: 0.85rem;
		color: var(--g1t-muted);
		text-decoration: none;
		transition: color 0.15s, background 0.15s;
	}
	a:hover {
		background: var(--g1t-raised);
		color: var(--g1t-fg);
	}
	.g1t-nav-cta {
		margin-left: 0.25rem;
		background: var(--g1t-fg);
		color: var(--g1t-bg);
		font-weight: 500;
	}
	.g1t-nav-cta:hover {
		background: #fff;
		color: var(--g1t-bg);
	}
	.g1t-nav-icon {
		display: inline-flex;
		padding: 0.4rem;
	}
	.g1t-nav-icon svg {
		width: 1rem;
		height: 1rem;
	}
	@media (max-width: 50rem) {
		a:not(.g1t-nav-icon):not(.g1t-nav-cta) {
			display: none;
		}
	}
</style>

---
// The header's right side: g1t.sh, its source, and signing up.
// g1t's social accounts live in g1t.sh's footer, not here.
import { ChevronRight } from '@lucide/astro';
---

<nav class="g1t-nav" aria-label="g1t">
	<a href="https://g1t.sh/">g1t.sh</a>
	<a href="https://g1t.sh/flagon-io/g1t">Source</a>
	<a href="https://g1t.sh/register" class="g1t-nav-cta">Sign up<ChevronRight /></a>
</nav>

<style>
	.g1t-nav {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}
	/* nav.g1t-nav: the menu's own link rule must not win where these sit
	   at the foot of the phone menu. */
	nav.g1t-nav a {
		display: inline-flex;
		align-items: center;
		height: 2rem;
		border-radius: 0.5rem;
		padding: 0 0.6rem;
		font-size: 0.875rem;
		font-weight: 500;
		white-space: nowrap;
		color: var(--g1t-muted);
		text-decoration: none;
		transition: color 0.15s, background 0.15s;
	}
	nav.g1t-nav a:hover {
		background: var(--g1t-raised);
		color: var(--g1t-fg);
	}
	/* The one call to action: a raised button, its chevron nudging on hover. */
	nav.g1t-nav .g1t-nav-cta {
		gap: 0.15rem;
		margin-left: 0.35rem;
		padding-inline: 0.75rem 0.5rem;
		background: var(--g1t-raised);
		box-shadow: inset 0 0 0 1px var(--g1t-line-strong);
		color: var(--g1t-fg);
		font-weight: 600;
	}
	nav.g1t-nav .g1t-nav-cta:hover {
		background: color-mix(in srgb, var(--g1t-accent) 12%, var(--g1t-raised));
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--g1t-accent) 50%, var(--g1t-line-strong));
		color: var(--g1t-fg);
	}
	.g1t-nav-cta :global(svg) {
		width: 0.875rem;
		height: 0.875rem;
		color: var(--g1t-muted);
		transition: transform 0.15s, color 0.15s;
	}
	.g1t-nav-cta:hover :global(svg) {
		transform: translateX(2px);
		color: var(--g1t-accent);
	}
	/* Tablets and phones: in the header only Sign up stays (the menu keeps
	   the rest). */
	@media (max-width: 49.99rem) {
		:global(.g1t-header) nav.g1t-nav a:not(.g1t-nav-cta) {
			display: none;
		}
		:global(.sidebar-content) nav.g1t-nav a {
			height: 2.5rem;
		}
	}
	/* Phones: Sign up leaves the header for the menu, where it has room. */
	@media (max-width: 44.99rem) {
		:global(.g1t-header) .g1t-nav {
			gap: 0;
		}
		:global(.g1t-header) nav.g1t-nav .g1t-nav-cta {
			display: none;
		}
	}
</style>

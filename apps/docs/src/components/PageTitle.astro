---
// A page's title, what it is about beneath it, and a way to take the page
// to an AI assistant: copied as Markdown, read as Markdown, or opened in
// Claude or ChatGPT.
import { ArrowUpRight, ChevronDown, Copy, FileText, MessageSquare } from '@lucide/astro';

const { entry, id } = Astro.locals.starlightRoute;
const { title, description } = entry.data;
const markdown = `/${id === '' || id === 'index' ? 'index' : id}.md`;
const absolute = new URL(markdown, Astro.site).href;
const ask = encodeURIComponent(`Read ${absolute} so I can ask questions about it.`);
---

<div class="g1t-page-title">
	<div class="g1t-page-title-row">
		<h1 id="_top">{title}</h1>
		<div class="g1t-copy not-content">
			<button type="button" class="g1t-copy-main" data-markdown={markdown}>
				<Copy />
				<span>Copy page</span>
			</button>
			<details class="g1t-copy-more">
				<summary aria-label="More ways to use this page">
					<ChevronDown />
				</summary>
				<div class="g1t-copy-menu">
					<a href={markdown} target="_blank" rel="noopener">
						<FileText class="g1t-copy-icon" />
						<span class="g1t-copy-text"><strong>View as Markdown</strong><small>This page as plain text</small></span>
					</a>
					<a href={`https://claude.ai/new?q=${ask}`} target="_blank" rel="noopener">
						<MessageSquare class="g1t-copy-icon" />
						<span class="g1t-copy-text"><strong>Open in Claude</strong><small>Ask questions about this page</small></span>
						<ArrowUpRight class="g1t-copy-out" />
					</a>
					<a href={`https://chatgpt.com/?hints=search&q=${ask}`} target="_blank" rel="noopener">
						<MessageSquare class="g1t-copy-icon" />
						<span class="g1t-copy-text"><strong>Open in ChatGPT</strong><small>Ask questions about this page</small></span>
						<ArrowUpRight class="g1t-copy-out" />
					</a>
				</div>
			</details>
		</div>
	</div>
	{description && <p class="g1t-description">{description}</p>}
</div>

<script>
	document.querySelectorAll<HTMLButtonElement>('.g1t-copy-main').forEach((button) => {
		button.addEventListener('click', async () => {
			const label = button.querySelector('span')!;
			try {
				const text = await (await fetch(button.dataset.markdown!)).text();
				await navigator.clipboard.writeText(text);
				label.textContent = 'Copied';
			} catch {
				label.textContent = 'Could not copy';
			}
			setTimeout(() => (label.textContent = 'Copy page'), 1600);
		});
	});
	// A menu closes when you click elsewhere.
	document.addEventListener('click', (event) => {
		document.querySelectorAll<HTMLDetailsElement>('.g1t-copy-more[open]').forEach((menu) => {
			if (!menu.contains(event.target as Node)) menu.open = false;
		});
	});
</script>

<style>
	.g1t-page-title {
		margin-top: 0.75rem;
	}
	.g1t-page-title-row {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1.5rem;
	}
	h1 {
		margin: 0;
		font-family: var(--g1t-font-display);
		font-optical-sizing: auto;
		font-size: 2rem;
		font-weight: 600;
		letter-spacing: -0.015em;
		line-height: 1.2;
		color: var(--g1t-fg);
	}
	.g1t-description {
		margin-top: 0.6rem;
		max-width: 42rem;
		font-size: 1.125rem;
		line-height: 1.55;
		color: var(--g1t-muted);
	}
	/* A button group: one bordered box, both parts the same height, and a
	   divider that runs the box's full height. */
	.g1t-copy {
		position: relative;
		display: inline-flex;
		align-items: stretch;
		flex-shrink: 0;
		height: 2rem;
		margin-top: 0.35rem;
		border: 1px solid var(--g1t-line);
		border-radius: 0.5rem;
	}
	.g1t-copy :global(svg) {
		display: block;
		flex-shrink: 0;
		width: 0.875rem;
		height: 0.875rem;
	}
	.g1t-copy-more {
		display: flex;
		margin: 0;
	}
	.g1t-copy-main,
	.g1t-copy-more summary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.375rem;
		height: 100%;
		margin: 0;
		border: 0;
		background: transparent;
		padding: 0 0.625rem;
		font: inherit;
		font-size: 0.8125rem;
		font-weight: 500;
		line-height: 1;
		color: var(--g1t-muted);
		cursor: pointer;
		transition: color 0.15s, background 0.15s;
	}
	.g1t-copy-main {
		border-radius: calc(0.5rem - 1px) 0 0 calc(0.5rem - 1px);
	}
	.g1t-copy-more summary {
		list-style: none;
		border-left: 1px solid var(--g1t-line);
		border-radius: 0 calc(0.5rem - 1px) calc(0.5rem - 1px) 0;
		padding-inline: 0.5rem;
	}
	.g1t-copy-main:focus-visible,
	.g1t-copy-more summary:focus-visible {
		outline: 2px solid var(--g1t-accent, currentColor);
		outline-offset: -2px;
	}
	.g1t-copy-more summary::-webkit-details-marker {
		display: none;
	}
	.g1t-copy-main:hover,
	.g1t-copy-more summary:hover {
		background: var(--g1t-surface);
		color: var(--g1t-fg);
	}
	.g1t-copy-menu {
		position: absolute;
		top: calc(100% + 0.4rem);
		right: 0;
		z-index: 10;
		width: 16.5rem;
		border-radius: 0.75rem;
		padding: 0.35rem;
		background: var(--g1t-raised);
		box-shadow:
			inset 0 0 0 1px var(--g1t-line-strong),
			0 12px 32px rgb(0 0 0 / 0.45);
	}
	/* Its own spacing: the page's prose rules stop at not-content, and
	   nothing inside keeps a margin of its own. */
	.g1t-copy-menu * {
		margin: 0;
	}
	.g1t-copy-menu a {
		display: flex;
		align-items: flex-start;
		gap: 0.6rem;
		border-radius: 0.5rem;
		padding: 0.5rem 0.6rem;
		text-decoration: none;
		transition: background 0.15s;
	}
	.g1t-copy-menu a + a {
		margin-top: 0.1rem;
	}
	.g1t-copy-menu a:hover {
		background: var(--g1t-surface);
	}
	.g1t-copy-menu :global(.g1t-copy-icon) {
		flex-shrink: 0;
		margin-top: 0.15rem;
		color: var(--g1t-faint);
	}
	.g1t-copy-menu :global(.g1t-copy-out) {
		flex-shrink: 0;
		margin-left: auto;
		margin-top: 0.15rem;
		width: 0.8rem;
		height: 0.8rem;
		color: var(--g1t-faint);
		opacity: 0;
		transition: opacity 0.15s;
	}
	.g1t-copy-menu a:hover :global(.g1t-copy-out) {
		opacity: 1;
	}
	.g1t-copy-text {
		display: flex;
		min-width: 0;
		flex-direction: column;
		gap: 0.1rem;
		line-height: 1.3;
	}
	.g1t-copy-menu strong {
		font-size: 0.8125rem;
		font-weight: 500;
		color: var(--g1t-fg);
	}
	.g1t-copy-menu small {
		font-size: 0.75rem;
		color: var(--g1t-faint);
	}
	@media (max-width: 40rem) {
		.g1t-copy {
			display: none;
		}
	}
</style>

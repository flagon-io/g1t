---
// One message in a <Conversation>: who wrote it, when, and the body (the
// slot, written in Markdown). Agents get a square lavender face and a tag.
interface Props {
	name: string;
	time: string;
	agent?: boolean;
	/** An agent's one-line role, shown beside its name. */
	role?: string;
}
const { name, time, agent = false, role } = Astro.props;
---

<div class="message">
	<span class:list={['face', { agent }]} aria-hidden="true">{name.charAt(0)}</span>
	<div class="main">
		<p class="meta">
			<span class="name">{name}</span>
			{agent && <span class="tag">Agent</span>}
			{role && <span class="role">{role}</span>}
			<span class="time">{time}</span>
		</p>
		<div class="body"><slot /></div>
	</div>
</div>

<style>
	.message {
		display: flex;
		gap: 0.75rem;
		padding: 0.6rem 1rem;
	}
	.face {
		flex: none;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border-radius: 999px;
		background: var(--g1t-raised);
		border: 1px solid var(--g1t-line-strong);
		color: var(--g1t-fg-soft);
		font-size: 0.75rem;
		font-weight: 600;
	}
	.face.agent {
		border-radius: 0.5rem;
		background: color-mix(in srgb, var(--g1t-accent) 15%, transparent);
		border-color: color-mix(in srgb, var(--g1t-accent) 30%, transparent);
		color: var(--g1t-accent);
	}
	.main {
		min-width: 0;
		flex: 1;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0 0.4rem;
		margin: 0;
		font-size: 0.8125rem;
	}
	.name {
		color: var(--g1t-fg);
		font-weight: 600;
	}
	.tag {
		padding: 0 0.3rem;
		border-radius: 0.25rem;
		background: color-mix(in srgb, var(--g1t-accent) 15%, transparent);
		color: var(--g1t-accent);
		font-family: var(--g1t-font-mono);
		font-size: 0.5625rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.role,
	.time {
		color: var(--g1t-faint);
		font-size: 0.75rem;
	}
	.body {
		color: var(--g1t-fg-soft);
		font-size: 0.875rem;
		line-height: 1.6;
	}
	.body :global(p),
	.body :global(ul) {
		margin: 0.25rem 0 0;
	}
	.body :global(ul) {
		padding-left: 1.1rem;
	}
	.body :global(li) {
		margin: 0;
	}
</style>

{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // As in tsconfig.base.json: the type check reads tsconfig.tsbuildinfo
    // and checks again only what changed.
    "incremental": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // Node runs the tests on the files as they are (`npm test`).
  "exclude": ["node_modules", "src/**/*.test.ts"]
}

{
  "name": "@g1t/mobile",
  "private": true,
  "version": "0.1.0",
  "description": "The g1t phone app (Expo): Chat and Code first, signed in with OAuth, for Android and iOS.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/lib/*.test.ts\"",
    "doctor": "expo-doctor",
    "icons": "node scripts/icons.mjs",
    "build:android:dev": "eas build --platform android --profile development",
    "build:android": "eas build --platform android --profile production",
    "build:android:apk": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios --profile production"
  },
  "dependencies": {
    "@g1t/contracts": "*",
    "@tanstack/react-query": "^5.104.1",
    "expo": "~57.0.27",
    "expo-auth-session": "~57.0.14",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "lucide-react-native": "^1.55.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3"
  }
}

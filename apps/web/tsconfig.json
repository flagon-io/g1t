{
  // The type check runs `tsc -p` on each of these, not `tsc -b`: build mode
  // skips a project none of whose own files is newer than its .tsbuildinfo,
  // and so missed changes in the shared contracts; `tsc -p` compares the
  // contents of every file it reads.
  "files": [],
  "references": [{ "path": "./tsconfig.node.json" }, { "path": "./tsconfig.cloudflare.json" }],
  "compilerOptions": {
    "checkJs": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    // Pure modules in app/lib import each other by file (`./money.ts`), the
    // way the tests do, so node runs them as they are and Vite bundles them.
    "allowImportingTsExtensions": true
  }
}

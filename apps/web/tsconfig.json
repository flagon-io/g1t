{
  "files": [],
  "references": [
    { "path": "./tsconfig.node.json" },
    { "path": "./tsconfig.cloudflare.json" }
  ],
  "compilerOptions": {
    "checkJs": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    // Pure modules in app/lib import each other by file (`./money.ts`), the
    // way the tests do, so node runs them as they are and Vite bundles them.
    "allowImportingTsExtensions": true
  }
}

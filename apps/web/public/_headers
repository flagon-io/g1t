# Static files served by Workers assets, ahead of the app.

# Fingerprinted by the build: a new file gets a new name, so each can be
# kept for good. That includes the typefaces.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Every static file: only the type it says, and a referrer of the origin
# alone, as the Worker's own answers (app/lib/page-headers.ts).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# The web app manifest, so a phone installs g1t to its home screen.
/manifest.webmanifest
  Content-Type: application/manifest+json

# The service worker (browser notifications only): always checked for a
# newer one, never kept, and allowed to control the whole site.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

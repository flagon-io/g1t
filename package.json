{
  "name": "g1t-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "deploy": "npm run deploy -w @g1t/web",
    "test:deploy": "node --test \"scripts/deploy/*.test.mjs\"",
    "test:ops": "node --test \"scripts/ops/*.test.mjs\""
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "wrangler": "^4.146.0"
  },
  "overrides": {
    "basic-ftp": "^6.2.1",
    "fflate": "^0.7.5",
    "postcss-selector-parser": "^7.1.6",
    "sharp": "^0.35.5"
  }
}

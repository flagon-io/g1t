{
  "name": "g1t-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "deploy": "npm run deploy -w @g1t/web",
    "test:deploy": "node --test \"scripts/deploy/*.test.mjs\"",
    "test:ops": "node --test \"scripts/ops/*.test.mjs\"",
    "test:conformance": "node --test \"conformance/*.test.mjs\"",
    "test:release": "node --test \"scripts/desktop-release.test.mjs\" \"scripts/mobile-release.test.mjs\""
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "wrangler": "^4.146.0"
  },
  "overrides": {
    "basic-ftp": "^6.2.1",
    "fflate": "^0.7.5",
    "katex": "^0.19.0",
    "postcss-selector-parser": "^7.1.6",
    "query-string": "^9.5.1",
    "sharp": "^0.35.5",
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
